{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "astrokites": {
      "root": "AstroKites",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/power-data",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/forecast",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/forecast-simple",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/check-date",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/state-7day-forecast",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/send-sms",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "astrokites"
      }
    }
  ]
}
